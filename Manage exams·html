<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manage Exams</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://evbjulsahncllewwvlxp.supabase.co">
<style>
  :root{
    --ink:#2c2116;
    --ink-2:#3a2f1c;
    --paper:#f4ecd8;
    --card:#fdfaf1;
    --line:rgba(185,129,47,0.22);
    --gold:#b9812f;
    --gold-2:#a5701f;
    --gold-soft:rgba(185,129,47,0.13);
    --success:#2e7d52;
    --success-soft:rgba(46,125,82,0.12);
    --error:#a3342a;
    --error-soft:rgba(163,52,42,0.11);
    --muted:#8a7a63;
    --cream-bg-1:#f4ecd8;
    --cream-bg-2:#f9f3e4;
    --shadow-sm:0 1px 2px rgba(120,90,40,0.08);
    --shadow-md:0 8px 24px rgba(120,90,40,0.12);
    --shadow-lg:0 20px 50px rgba(120,90,40,0.16);
  }
  *{ margin:0; padding:0; box-sizing:border-box; }
  html,body{ height:100%; }
  body{
    font-family:'Inter',sans-serif;
    background:
      radial-gradient(circle at 15% 10%, rgba(185,129,47,0.10), transparent 45%),
      radial-gradient(circle at 85% 90%, rgba(185,129,47,0.08), transparent 45%),
      linear-gradient(160deg, var(--cream-bg-1), var(--cream-bg-2));
    color:var(--ink);
    min-height:100vh;
    padding:32px 24px 64px;
  }
  .num{ font-family:'Space Grotesk',sans-serif; }

  /* ===== Header ===== */
  .topbar{
    max-width:1200px; margin:0 auto 26px;
    display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
  }
  .brand{ display:flex; align-items:center; gap:14px; }
  .brand-mark{
    width:46px; height:46px; border-radius:50%; flex-shrink:0;
    background:var(--gold);
    opacity:0.92;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 8px 18px rgba(185,129,47,0.35);
    font-size:20px;
  }
  .brand-text{ text-align:left; }
  .brand-eyebrow{
    font-size:10.5px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--gold); font-weight:700; margin-bottom:2px;
  }
  .brand h1{ font-family:'Cormorant Garamond',serif; font-size:26px; font-weight:700; color:var(--gold-2); letter-spacing:-0.01em; }
  .brand p{ font-size:12.5px; color:var(--muted); margin-top:2px; }
  .top-actions{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .back-btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 18px; border-radius:10px;
    background:var(--card); border:1px solid var(--line);
    color:var(--ink); font-family:'Inter',sans-serif; font-size:13px; font-weight:700;
    text-decoration:none; transition:all .15s ease; white-space:nowrap;
  }
  .back-btn:hover{ border-color:var(--gold); color:var(--gold-2); }

  .wrap{ max-width:1200px; margin:0 auto; }
  .tab-panel{
    background:var(--card); border:1px solid var(--line); border-radius:16px;
    padding:30px; box-shadow:var(--shadow-lg); position:relative;
  }

  .state-msg{
    display:none; align-items:center; justify-content:center; gap:10px;
    padding:64px 10px; color:var(--muted); font-size:13.5px; text-align:center;
  }
  .state-msg.show{ display:flex; }
  .state-msg.err{ color:var(--error); flex-direction:column; gap:9px; }
  .state-msg .spinner{
    width:18px; height:18px; border-radius:50%; border:2px solid rgba(185,129,47,0.18);
    border-top-color:var(--gold); animation:spin .7s linear infinite; flex-shrink:0;
  }
  @keyframes spin{ to{ transform:rotate(360deg); } }
  .content{ display:none; }
  .content.show{ display:block; }

  .section-title{
    display:flex; align-items:center; gap:9px;
    font-family:'Cormorant Garamond',serif; font-weight:700; font-size:18px; color:var(--gold-2); margin-bottom:15px;
  }
  .section-title .tag{
    font-family:'Inter',sans-serif; font-size:10px; font-weight:700; color:var(--gold); background:var(--gold-soft);
    padding:3px 9px; border-radius:999px; letter-spacing:.03em; text-transform:uppercase;
  }

  .chart-card{
    background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:19px;
    margin-bottom:22px;
  }

  .hist-toolbar{
    display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    margin-bottom:22px;
  }
  .hist-toolbar .left{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .hist-select{
    padding:10px 14px; border-radius:9px; border:1px solid var(--line); background:var(--card);
    color:var(--ink); font-family:'Inter',sans-serif; font-size:12.5px; font-weight:600; cursor:pointer; outline:none;
  }
  .search-box{ flex:1; min-width:200px; position:relative; }
  .search-box input{
    width:100%; padding:10px 14px 10px 38px; border-radius:10px; border:1px solid var(--line);
    background:var(--card); font-family:'Inter',sans-serif; font-size:13px; outline:none; color:var(--ink);
    transition:border-color .15s ease, box-shadow .15s ease;
  }
  .search-box input:focus{ border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-soft); }
  .search-box::before{
    content:"⌕"; position:absolute; left:13px; top:50%; transform:translateY(-50%);
    color:var(--muted); font-size:15px; pointer-events:none;
  }

  .save-snapshot-btn{
    display:flex; align-items:center; gap:8px; padding:10px 18px; border-radius:9px; border:none;
    background:linear-gradient(135deg, var(--gold-2) 0%, var(--gold) 100%); color:#241a05;
    font-family:'Inter',sans-serif; font-weight:700; font-size:12.5px; cursor:pointer;
    box-shadow:0 6px 16px rgba(120,95,40,0.2); transition:all .15s ease;
  }
  .save-snapshot-btn:hover{ filter:brightness(1.06); transform:translateY(-1px); }
  .save-snapshot-btn:disabled{ opacity:.6; cursor:default; transform:none; }
  .ghost-btn{
    padding:10px 18px; border-radius:9px; border:1px solid var(--line); background:var(--card);
    color:var(--ink); font-family:'Inter',sans-serif; font-weight:700; font-size:12.5px; cursor:pointer;
    transition:all .15s ease;
  }
  .ghost-btn:hover{ border-color:var(--gold); }
  .hist-table-note{ font-size:11px; color:var(--muted); margin-bottom:12px; }

  .table-wrap{ overflow-x:auto; border:1px solid var(--line); border-radius:12px; }
  table{ width:100%; border-collapse:collapse; font-size:12.5px; min-width:600px; }
  thead th{
    text-align:left; padding:12px 14px; background:var(--paper); color:var(--gold-2);
    font-weight:700; font-size:10.5px; text-transform:uppercase; letter-spacing:.05em;
    border-bottom:1px solid var(--line); white-space:nowrap;
  }
  tbody td{ padding:11px 14px; border-bottom:1px solid var(--line); color:var(--ink); white-space:nowrap; }
  tbody tr:last-child td{ border-bottom:none; }
  tbody tr:hover{ background:rgba(185,129,47,0.07); }
  .empty-note{ text-align:center; color:var(--muted); font-size:12.5px; padding:20px 0; }

  .unpaid-link{
    border:none; background:rgba(163,52,42,0.08); color:var(--error); cursor:pointer;
    font-family:'Inter',sans-serif; font-weight:700; font-size:11.5px; padding:6px 11px; border-radius:8px;
    transition:all .15s ease;
  }
  .unpaid-link:hover{ background:var(--error-soft); }

  .list-row{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:10px 4px; border-bottom:1px solid var(--line); font-size:13px;
  }
  .list-row:last-child{ border-bottom:none; }
  .list-name .name{ font-weight:600; color:var(--ink); }

  .score-input{
    width:90px; padding:8px 10px; border-radius:8px; border:1px solid var(--line);
    background:var(--card); font-family:'Space Grotesk',sans-serif; font-size:13px; color:var(--ink); outline:none;
  }
  .score-input:focus{ border-color:var(--gold); box-shadow:0 0 0 3px var(--gold-soft); }

  /* ===== Modal ===== */
  .modal-overlay{
    display:none; position:fixed; inset:0; background:rgba(44,33,22,0.45); z-index:80;
    align-items:center; justify-content:center; padding:20px;
  }
  .modal-overlay.show{ display:flex; }
  .modal-box{
    background:var(--card); border-radius:16px; max-width:440px; width:100%; max-height:80vh;
    overflow:auto; padding:22px; box-shadow:var(--shadow-lg); border:1px solid var(--line);
  }
  .modal-close{ border:none; background:none; font-size:22px; cursor:pointer; color:var(--muted); line-height:1; }
  .modal-close:hover{ color:var(--ink); }

  .footer-note{ text-align:center; font-size:11.5px; color:var(--muted); margin-top:30px; display:flex; align-items:center; justify-content:center; gap:7px; }
  .footer-note::before{ content:"🔒"; font-size:11px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">
    <div class="brand-mark">➕</div>
    <div class="brand-text">
      <div class="brand-eyebrow">Live insights</div>
      <h1>Manage Exams</h1>
      <p>Add exams and enter student scores</p>
    </div>
  </div>
  <div class="top-actions">
    <a class="back-btn" href="dashboard.html">← Back to Dashboard</a>
  </div>
</div>

<div class="wrap">
  <div class="tab-panel">

    <div class="state-msg show" id="examManageLoadingMsg">
      <span class="spinner"></span> Loading grades…
    </div>
    <div class="state-msg err" id="examManageErrorMsg"></div>

    <div class="content" id="examManageContent">

      <div class="hist-toolbar">
        <div class="left">
          <select class="hist-select" id="examManageGradeSelect" onchange="onExamManageGradeChange()">
            <option value="first">First Secondary</option>
            <option value="second">Second Secondary</option>
            <option value="third">Third Secondary</option>
          </select>
          <div class="search-box" style="min-width:200px;">
            <input type="text" id="examManageSearch" placeholder="Search by student name…" oninput="renderExamManageTable()">
          </div>
        </div>
        <button class="save-snapshot-btn" onclick="openAddExamModal()">➕ Add Exam</button>
      </div>

      <div class="chart-card" id="examEntryPanel" style="display:none;">
        <div class="section-title" id="examEntryTitle"></div>
        <div id="examEntryBody"></div>
        <div style="display:flex; gap:10px; margin-top:14px;">
          <button class="save-snapshot-btn" id="saveExamEntryBtn" onclick="saveScoreEntry()">💾 Save Grades</button>
          <button class="ghost-btn" onclick="cancelScoreEntry()">Cancel</button>
        </div>
      </div>

      <div class="chart-card" style="margin-bottom:0;">
        <div class="section-title">Manage Grades <span class="tag">Enter scores & manage exams</span></div>
        <div class="hist-table-note">Each new exam is saved as a separate column, and old grades stay in place even after you add new exam scores.</div>
        <div class="table-wrap">
          <table>
            <thead id="examManageTableHead"></thead>
            <tbody id="examManageTableBody"></tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <div class="footer-note">Changes are written live to Supabase</div>
</div>

<!-- Add exam modal -->
<div class="modal-overlay" id="addExamModalOverlay" onclick="if(event.target===this) closeAddExamModal()">
  <div class="modal-box">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px;">
      <div class="section-title" style="margin-bottom:0;">Add Exam</div>
      <button class="modal-close" onclick="closeAddExamModal()">×</button>
    </div>
    <div style="display:flex; flex-direction:column; gap:14px;">
      <div>
        <div style="font-size:10.5px; color:var(--muted); font-weight:700; letter-spacing:.06em; text-transform:uppercase; margin-bottom:6px;">Exam Name</div>
        <input type="text" id="examNameInput" class="hist-select" style="width:100%;" placeholder="e.g. Quiz 1">
      </div>
      <div>
        <div style="font-size:10.5px; color:var(--muted); font-weight:700; letter-spacing:.06em; text-transform:uppercase; margin-bottom:6px;">Maximum Score</div>
        <input type="number" id="examMaxScoreInput" class="hist-select" style="width:100%;" value="100" min="1" step="1">
      </div>
      <div>
        <div style="font-size:10.5px; color:var(--muted); font-weight:700; letter-spacing:.06em; text-transform:uppercase; margin-bottom:6px;">Grade</div>
        <select id="examGradeInput" class="hist-select" style="width:100%;">
          <option value="first">First Secondary</option>
          <option value="second">Second Secondary</option>
          <option value="third">Third Secondary</option>
        </select>
      </div>
      <button class="save-snapshot-btn" id="saveNewExamBtn" onclick="saveNewExam()" style="justify-content:center;">Save</button>
    </div>
  </div>
</div>

<script>
  /* ============================================================
     SUPABASE CONNECTION — same project as the dashboard
     ============================================================ */
  const SUPABASE_URL = "https://evbjulsahncllewwvlxp.supabase.co";
  const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV2Ymp1bHNhaG5jbGxld3d2bHhwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM2NzE5MjUsImV4cCI6MjA5OTI0NzkyNX0.Xg9sU6ZenUU3kC2RNIbvZmK19KvE28MM2oyGcKNn8UA";
  const supa = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  // Change only the right-hand side here if your real column/table names differ.
  const SCHEMA = {
    attendanceTable: (g) => `attendance_${g}_secondary`,
    paymentsTable: (g) => `payments_${g}_secondary`,
    col: {
      fullName: "full_name",
      qrCode: "qr_code",
      studentPhone: "student_phone",
      parentPhone: "parent_phone",
      attendanceCount: "attendance_count",
      absenceCount: "absence_count",
      lastAttendance: "last_attendance",
      amountPaid: "amount_paid",
      paymentStatus: "payment_status",
      lastPaymentDate: "last_payment_date"
    }
  };

  const GRADE_LABELS = { first: "First Secondary", second: "Second Secondary", third: "Third Secondary" };

  /* ---------- Fetch + merge one grade (attendance + payment, tagged) ---------- */
  async function fetchGrade(grade){
    const [{ data: att, error: attErr }, { data: pay, error: payErr }] = await Promise.all([
      supa.from(SCHEMA.attendanceTable(grade)).select("*"),
      supa.from(SCHEMA.paymentsTable(grade)).select("*")
    ]);
    if(attErr) throw new Error(`(${SCHEMA.attendanceTable(grade)}) ${attErr.message}`);
    if(payErr) throw new Error(`(${SCHEMA.paymentsTable(grade)}) ${payErr.message}`);

    const col = SCHEMA.col;
    const payByCode = {};
    (pay || []).forEach(p => { payByCode[p[col.qrCode]] = p; });

    return (att || []).map(a => {
      const p = payByCode[a[col.qrCode]] || {};
      return {
        grade,
        name: a[col.fullName] ?? "",
        qrCode: a[col.qrCode] ?? "",
        studentPhone: a[col.studentPhone] ?? "",
        parentPhone: a[col.parentPhone] ?? "",
        attendanceCount: Number(a[col.attendanceCount] || 0),
        absenceCount: Number(a[col.absenceCount] || 0),
        lastAttendance: a[col.lastAttendance] ?? "",
        paymentStatus: p[col.paymentStatus] ?? "",
        amountPaid: Number(p[col.amountPaid] || 0),
        lastPaymentDate: p[col.lastPaymentDate] ?? ""
      };
    });
  }

  /* ============================================================
     EXAM GRADES (dynamic columns, driven by an "exams" table)
     Needs two shared tables in Supabase (not one per grade):

       create table exams (
         id bigint generated always as identity primary key,
         exam_name text not null,
         max_score numeric not null default 100,
         grade text not null,              -- 'first' | 'second' | 'third'
         created_at timestamptz default now()
       );

       create table exam_scores (
         id bigint generated always as identity primary key,
         exam_id bigint not null references exams(id) on delete cascade,
         student_code text not null,       -- matches qr_code in the attendance tables
         score numeric not null,
         created_at timestamptz default now()
       );

     Both need SELECT + INSERT (+ DELETE, for re-saving scores) policies
     for the anon role. Adding a new exam just inserts one row into
     `exams` — the grades table below generates its columns dynamically
     from whatever exams exist for the selected grade, so no schema
     change is needed each time a new exam is added.

     This page writes to those tables; the read-only "Exam Grades" tab
     on the main dashboard displays the results.
     ============================================================ */
  const EXAMS_SCHEMA = {
    table: "exams",
    col: { id: "id", name: "exam_name", maxScore: "max_score", grade: "grade", createdAt: "created_at" }
  };
  const SCORES_SCHEMA = {
    table: "exam_scores",
    col: { id: "id", examId: "exam_id", studentCode: "student_code", score: "score" }
  };

  let examGrade = "first";
  let examStudents = [];
  let examList = [];    // rows from `exams` for the selected grade
  let examScores = [];  // rows from `exam_scores` for those exams

  function onExamManageGradeChange(){
    examGrade = document.getElementById("examManageGradeSelect").value;
    loadExamGrades();
  }

  async function loadExamGrades(){
    const loadingEl = document.getElementById("examManageLoadingMsg");
    const errorEl = document.getElementById("examManageErrorMsg");
    const contentEl = document.getElementById("examManageContent");
    loadingEl.classList.add("show");
    errorEl.classList.remove("show");
    contentEl.classList.remove("show");
    try{
      const ecol = EXAMS_SCHEMA.col;
      const [students, { data: exams, error: examsErr }] = await Promise.all([
        fetchGrade(examGrade),
        supa.from(EXAMS_SCHEMA.table).select("*").eq(ecol.grade, examGrade).order(ecol.createdAt, { ascending: true })
      ]);
      if(examsErr) throw examsErr;

      examStudents = students;
      examList = exams || [];

      let scores = [];
      if(examList.length){
        const scol = SCORES_SCHEMA.col;
        const ids = examList.map(e => e[ecol.id]);
        const { data: scoreRows, error: scoresErr } = await supa.from(SCORES_SCHEMA.table).select("*").in(scol.examId, ids);
        if(scoresErr) throw scoresErr;
        scores = scoreRows || [];
      }
      examScores = scores;

      renderExamManageTable();
      contentEl.classList.add("show");
    }catch(err){
      console.error(err);
      errorEl.innerHTML = `
        <div style="font-weight:700;">Couldn't load grades</div>
        <div style="font-size:12px; max-width:520px;">
          ${err.message || err}<br><br>
          This most likely means the "exams" or "exam_scores" tables don't exist yet, or the anon role
          doesn't have SELECT/INSERT permission for them. See the schema in the code comments above.
        </div>`;
      errorEl.classList.add("show");
    }finally{
      loadingEl.classList.remove("show");
    }
  }

  /* ---------- Manage grades table ---------- */
  function renderExamManageTable(){
    const head = document.getElementById("examManageTableHead");
    const body = document.getElementById("examManageTableBody");
    if(!head || !body) return;
    const ecol = EXAMS_SCHEMA.col;
    const scol = SCORES_SCHEMA.col;

    head.innerHTML = `<tr>
      <th>Name</th>
      ${examList.map(e => `
        <th>
          ${e[ecol.name]}
          <button class="unpaid-link" style="margin-inline-start:6px; padding:2px 8px;" onclick="openScoreEntryById(${e[ecol.id]})">✏️ Enter</button>
          <button class="unpaid-link" style="margin-inline-start:4px; padding:2px 8px;" onclick="confirmDeleteExam(${e[ecol.id]})" title="Delete this exam">🗑</button>
        </th>`).join("")}
      <th>Average</th>
    </tr>`;

    if(!examStudents.length){
      body.innerHTML = `<tr><td colspan="${examList.length + 2}" style="text-align:center; color:var(--muted); padding:24px;">No students in this grade</td></tr>`;
      return;
    }

    const q = (document.getElementById("examManageSearch")?.value || "").trim().toLowerCase();
    const rowsToShow = q ? examStudents.filter(s => (s.name || "").toLowerCase().includes(q)) : examStudents;

    if(!rowsToShow.length){
      body.innerHTML = `<tr><td colspan="${examList.length + 2}" style="text-align:center; color:var(--muted); padding:24px;">No students match "${q}"</td></tr>`;
      return;
    }

    body.innerHTML = rowsToShow.map(s => {
      let sumPct = 0, cnt = 0;
      const cells = examList.map(e => {
        const row = examScores.find(sc => sc[scol.examId] === e[ecol.id] && sc[scol.studentCode] === s.qrCode);
        if(!row){ return `<td style="color:var(--muted); text-align:center;">☐</td>`; }
        const sc = Number(row[scol.score]);
        const mx = Number(e[ecol.maxScore]) || 100;
        if(!isNaN(sc)){ sumPct += (sc / mx) * 100; cnt++; }
        return `<td>${row[scol.score]} / ${e[ecol.maxScore]}</td>`;
      }).join("");
      const avg = cnt ? Math.round(sumPct / cnt) : null;
      return `<tr>
        <td style="font-weight:600;">${s.name || "—"}</td>
        ${cells}
        <td>${avg != null ? avg + "%" : "—"}</td>
      </tr>`;
    }).join("");
  }

  /* ---------- Delete exam ---------- */
  function confirmDeleteExam(examId){
    const ecol = EXAMS_SCHEMA.col;
    const exam = examList.find(e => e[ecol.id] === examId);
    const name = exam ? exam[ecol.name] : "this exam";
    const ok = confirm(`Are you sure you want to delete "${name}"?\n\nThis will permanently remove the exam and all student grades entered for it. This can't be undone.`);
    if(ok) deleteExam(examId);
  }

  async function deleteExam(examId){
    try{
      const scol = SCORES_SCHEMA.col;
      const ecol = EXAMS_SCHEMA.col;
      // Delete scores first (in case there's no ON DELETE CASCADE set up on the FK).
      await supa.from(SCORES_SCHEMA.table).delete().eq(scol.examId, examId);
      const { error } = await supa.from(EXAMS_SCHEMA.table).delete().eq(ecol.id, examId);
      if(error) throw error;

      // If the score-entry panel was open for this exam, close it.
      const panel = document.getElementById("examEntryPanel");
      if(panel.dataset.examId && Number(panel.dataset.examId) === examId){
        cancelScoreEntry();
      }

      await loadExamGrades();
    }catch(err){
      alert("Couldn't delete the exam: " + (err.message || err));
    }
  }

  /* ---------- Add Exam popup ---------- */
  function openAddExamModal(){
    document.getElementById("examNameInput").value = "";
    document.getElementById("examMaxScoreInput").value = "100";
    document.getElementById("examGradeInput").value = examGrade;
    document.getElementById("addExamModalOverlay").classList.add("show");
  }
  function closeAddExamModal(){
    document.getElementById("addExamModalOverlay").classList.remove("show");
  }

  async function saveNewExam(){
    const name = document.getElementById("examNameInput").value.trim();
    const maxScore = Number(document.getElementById("examMaxScoreInput").value);
    const grade = document.getElementById("examGradeInput").value;
    if(!name){ alert("Please enter an exam name"); return; }
    if(!maxScore || maxScore <= 0){ alert("Please enter a valid maximum score"); return; }

    const btn = document.getElementById("saveNewExamBtn");
    btn.disabled = true; btn.textContent = "Saving…";
    try{
      const ecol = EXAMS_SCHEMA.col;
      const { data, error } = await supa.from(EXAMS_SCHEMA.table).insert([{
        [ecol.name]: name, [ecol.maxScore]: maxScore, [ecol.grade]: grade
      }]).select();
      if(error) throw error;

      closeAddExamModal();
      examGrade = grade;
      document.getElementById("examManageGradeSelect").value = grade;
      await loadExamGrades();

      // Jump straight into entering scores for the exam that was just created.
      const newExam = data && data[0];
      if(newExam) openScoreEntry(newExam);
    }catch(err){
      alert("Couldn't save the exam: " + (err.message || err) +
        (err.hint ? "\nHint: " + err.hint : "") +
        (err.details ? "\nDetails: " + err.details : "") +
        "\n\nMake sure an \"exams\" table exists with SELECT/INSERT grants + policies for the anon role.");
    }finally{
      btn.disabled = false; btn.textContent = "Save";
    }
  }

  /* ---------- Score entry panel ---------- */
  function openScoreEntryById(examId){
    const ecol = EXAMS_SCHEMA.col;
    const exam = examList.find(e => e[ecol.id] === examId);
    if(exam) openScoreEntry(exam);
  }

  function openScoreEntry(exam){
    const ecol = EXAMS_SCHEMA.col;
    const scol = SCORES_SCHEMA.col;
    const maxScore = exam[ecol.maxScore];
    const panel = document.getElementById("examEntryPanel");
    document.getElementById("examEntryTitle").textContent = `Enter Grades: ${exam[ecol.name]} (out of ${maxScore})`;
    document.getElementById("examEntryBody").innerHTML = examStudents.map(s => {
      const existing = examScores.find(sc => sc[scol.examId] === exam[ecol.id] && sc[scol.studentCode] === s.qrCode);
      return `
      <div class="list-row">
        <div class="list-name"><span class="name">${s.name || "—"}</span></div>
        <input type="number" class="score-input" data-code="${s.qrCode}" min="0" max="${maxScore}" step="0.5" placeholder="/ ${maxScore}" value="${existing ? existing[scol.score] : ''}">
      </div>`;
    }).join("");
    panel.style.display = "block";
    panel.dataset.examId = exam[ecol.id];
    panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  function cancelScoreEntry(){
    document.getElementById("examEntryPanel").style.display = "none";
  }

  async function saveScoreEntry(){
    const panel = document.getElementById("examEntryPanel");
    const examId = Number(panel.dataset.examId);
    const inputs = panel.querySelectorAll(".score-input");
    const scol = SCORES_SCHEMA.col;
    const rows = [];
    inputs.forEach(inp => {
      const v = inp.value.trim();
      if(v === "") return;
      rows.push({
        [scol.examId]: examId,
        [scol.studentCode]: inp.dataset.code,
        [scol.score]: Number(v)
      });
    });

    const btn = document.getElementById("saveExamEntryBtn");
    btn.disabled = true; btn.textContent = "Saving…";
    try{
      // Clear any previous scores for this exam first, so re-saving just updates them
      // (this also covers editing scores that were entered earlier).
      await supa.from(SCORES_SCHEMA.table).delete().eq(scol.examId, examId);
      if(rows.length){
        const { error } = await supa.from(SCORES_SCHEMA.table).insert(rows);
        if(error) throw error;
      }
      cancelScoreEntry();
      await loadExamGrades();
    }catch(err){
      alert("Couldn't save grades: " + (err.message || err));
    }finally{
      btn.disabled = false; btn.textContent = "💾 Save Grades";
    }
  }

  loadExamGrades();
</script>
</body>
</html>
